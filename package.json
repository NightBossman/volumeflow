{
  "name": "volumeflow",
  "version": "1.5.1",
  "description": "Premium Windows Audio Mixer",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"cross-env NODE_ENV=development electron .\"",
    "build": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "keywords": [],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^41.0.0",
    "electron-builder": "^24.13.3",
    "svelte": "^5.0.0",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@lucide/svelte": "^0.479.0"
  },
  "build": {
    "appId": "com.antigravity.volumeflow",
    "files": [
      "dist/**/*",
      "main.js",
      "preload.cjs",
      "AudioBridge.exe",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "public/icon.ico"
    }
  }
}
